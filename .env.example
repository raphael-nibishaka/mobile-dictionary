# Copy this file to ".env" and adjust values as needed.
#
# Base URL for the Free Dictionary API. The trailing slash is required because
# the word is appended directly (e.g. <base>/hello).
# The EXPO_PUBLIC_ prefix is what makes the value available in app code.
EXPO_PUBLIC_DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en/
